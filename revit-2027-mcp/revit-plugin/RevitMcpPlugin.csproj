<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revit 2027 eklentisi. Revit 2025+ .NET 8 kullanır.
    RevitAPI yolu kurulumunuza göre değişebilir; gerekirse RevitDir'i düzenleyin.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RevitMcpPlugin</AssemblyName>
    <RootNamespace>RevitMcpPlugin</RootNamespace>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RevitVersion>2027</RevitVersion>
    <RevitDir>C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- System.Text.Json .NET 8 ile birlikte gelir; ek paket gerekmez. -->

  <!-- Derleme sonrası .addin manifestini Revit eklenti klasörüne kopyalar. -->
  <Target Name="DeployAddin" AfterTargets="Build">
    <PropertyGroup>
      <AddinDir>$(ProgramData)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\RevitMcpPlugin.addin"
          DestinationFolder="$(AddinDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(AddinDir)RevitMcpPlugin\" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Eklenti kopyalandı: $(AddinDir)" />
  </Target>

</Project>
